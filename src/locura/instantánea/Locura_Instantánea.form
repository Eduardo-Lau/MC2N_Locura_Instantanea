              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextArea1">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="Segoe UI" size="18" style="2"/>
                    </Property>
                    <Property name="rows" type="int" value="2"/>
                    <Property name="text" type="java.lang.String" value="Por &#xfa;ltimo, se interpretan ambos subgrafos de la siguiente forma:&#xa; Soluci&#xf3;n Horizontal: (Grafo G1- recorrido horario)&#xa; - Se localiza la arista 1 (cubo 1) y se observa que v&#xe9;rtices conecta.&#xa; - En el cubo 1 se colocan estos 2 colores, de izquierda a derecha. (por ejemplo, R-B)&#xa; - Se observa en que v&#xe9;rtice termina la arista 1, y a partir de ese v&#xe9;rtice se observa la&#xa;   siguiente arista y los v&#xe9;rtices que conecta, as&#xed; sucesivamente. Siempre en sentido&#xa;   horario.                                                                                             &#x2193; Deslice hacia abajo &#x2193;&#xa;&#xa;Soluci&#xf3;n Vertical: (Grafo G2- recorrido horario)&#xa; - Se localiza la arista 1 (cubo 1) y se observa que v&#xe9;rtices conecta.&#xa; - En el cubo 1 se colocan estos 2 colores, de arriba hacia abajo. (por ejemplo, V-A)&#xa; - Se observa en que v&#xe9;rtice termina la arista 1, y a partir de ese v&#xe9;rtice se observa la&#xa;   siguiente arista y los v&#xe9;rtices que conecta, as&#xed; sucesivamente. Siempre en sentido&#xa;   horario."/>
                    <Property name="border" type="javax.swing.border.Border" editor="org.netbeans.modules.form.editors2.BorderEditor">
                      <Border info="null"/>
                    </Property>
                    <Property name="focusable" type="boolean" value="false"/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
